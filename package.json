{
  "name": "project-navigator",
  "type": "module",
  "version": "1.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "create-user": "tsx --env-file=.env scripts/createUser.ts",
    "reconcile-equipo": "tsx --env-file=.env scripts/reconcileEquipo.ts",
