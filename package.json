    "chevrotain": "^12.0.0",
    "brace-expansion": "^5.0.6",
    "qs": "^6.15.2",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.0"
