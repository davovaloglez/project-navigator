    "auth:generate": "better-auth generate --output ./src/db/auth-schema.sql --y",
    "db:init": "tsx --env-file=.env scripts/initTursoDb.ts",
    "docs:validate": "tsx scripts/validateDocs.ts",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.4",
    "@aws-sdk/client-s3": "^3.1062.0",
    "@googleapis/sheets": "^13.0.2",
    "@libsql/client": "^0.17.3",
    "@libsql/kysely-libsql": "^0.4.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.2.2",
    "astro-aws-amplify": "^0.4.1",
    "better-auth": "^1.6.11",
    "dompurify": "^3.4.11",
    "google-auth-library": "^10.7.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
