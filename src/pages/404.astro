---
// 404 page — intentionally does NOT use Layout.astro to avoid leaking the
// authenticated Sidebar on unknown routes that might be served pre-auth.
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=20260527" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260527" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260527" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260527" />
    <meta name="apple-mobile-web-app-title" content="P-Nav" />
    <link rel="manifest" href="/site.webmanifest?v=20260527" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>No encontrado | Project Navigator</title>
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: #020617; color: #e2e8f0; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
      .wrap { text-align: center; padding: 2rem; max-width: 28rem; }
      .code { font-size: 4.5rem; font-weight: 700; color: #334155; margin: 0 0 1rem; }
      h1 { font-size: 1.25rem; color: #ffffff; margin: 0 0 .5rem; }
      p { font-size: .875rem; color: #94a3b8; margin: 0 0 1.5rem; }
      .row { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
      a { text-decoration: none; padding: .5rem 1rem; border-radius: .5rem; font-size: .875rem; transition: background-color .15s; }
      .primary { background: rgba(59,130,246,.15); color: #60a5fa; }
      .primary:hover { background: rgba(59,130,246,.25); }
      .secondary { background: #1e293b; color: #cbd5e1; }
      .secondary:hover { background: #334155; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="code">404</p>
      <h1>Página no encontrada</h1>
      <p>La página que buscas no existe o fue movida.</p>
      <div class="row">
        <a href="/" class="primary">Ir al Dashboard</a>
        <a href="/portafolio" class="secondary">Ver Portafolio</a>
      </div>
    </div>
  </body>
</html>
