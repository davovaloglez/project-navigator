---
import "../styles/global.css";
import LoginForm from "../components/auth/LoginForm";

const redirect = Astro.url.searchParams.get("redirect") ?? "/";
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png?v=20260527"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260527" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260527" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=20260527"
    />
    <meta name="apple-mobile-web-app-title" content="P-Nav" />
    <link rel="manifest" href="/site.webmanifest?v=20260527" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión | Project Navigator</title>
  </head>
  <body
    class="bg-slate-950 text-slate-200 min-h-screen flex items-center justify-center p-4"
  >
    <div class="w-full max-w-sm">
      <div class="text-center mb-6">
        <h1 class="text-xl font-bold text-white tracking-tight">
          Project Navigator
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">Vortex IT</p>
      </div>
      <LoginForm client:load redirect={redirect} />
    </div>
  </body>
</html>
