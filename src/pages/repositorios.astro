---
import Layout from '../layouts/Layout.astro';
import RepositoriosSection from '../components/sections/RepositoriosSection';
import { can } from '../lib/permissions';

const canManage = await can(Astro.locals.user, 'action:repositorio:manage');
---

<Layout title="Repositorios">
  <RepositoriosSection
    client:load
    isSuperadmin={Astro.locals.isSuperadmin}
    activeEmpresa={Astro.locals.activeEmpresa}
    canManage={canManage}
  />
</Layout>
