# Google Sheets (data source)
GOOGLE_CREDENTIALS={"type":"service_account",...}
SHEET_ID=<spreadsheet_id>

# Turso (auth database)
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso db tokens create ...>

# Better-Auth
BETTER_AUTH_SECRET=<openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:4321

# Google OAuth (for "Sign in with Google")
GOOGLE_OAUTH_CLIENT_ID=<from Google Cloud Console>
GOOGLE_OAUTH_CLIENT_SECRET=<from Google Cloud Console>

# Optional: restrict signups to a specific email domain (e.g. bit.lat)
ALLOWED_GOOGLE_DOMAIN=

# Cron auth — bearer que el scheduler externo (AWS EventBridge Scheduler) debe
# enviar como `Authorization: Bearer <CRON_SECRET>` para invocar
# /api/snapshots/auto-capture sin sesión. Si queda vacío, el endpoint no exige el bearer.
CRON_SECRET=<openssl rand -base64 32>

# Avatares de perfil — Amazon S3 (vía @aws-sdk/client-s3).
# AVATAR_S3_BUCKET es requerido para subir/borrar fotos. Las credenciales de AWS
# se toman de la cadena por defecto del SDK: en Amplify, del rol de ejecución; en
# local, de AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (o ~/.aws/credentials).
AVATAR_S3_BUCKET=<nombre del bucket S3>
AWS_REGION=us-east-1
# Opcional: dominio del CDN (CloudFront) frente al bucket. Si se omite, se usa la
# URL pública directa del bucket (https://<bucket>.s3.amazonaws.com/<key>).
AVATAR_CDN_URL=

# CS 360 (Neural Intelligence 360) — análisis con IA vía el servicio Nexus
# (ai.bit.lat, NAV-85). Bearer token server-side para /api/cs360/analyze. Si
# queda vacío, el tablero funciona pero el botón "Generar" responde 503 con
# mensaje amigable. El prompt/modelo se administran en el panel de Nexus.
AI_BEARER_TOKEN=
# Datos del tablero CS 360. Cadena de fuentes: URL remota → S3 propio →
# archivo local → mock curado.
# CS360_DATA_URL: URL pública del export publicado por Samva (static.samva.io,
#   ~46MB sin comprimir; el path trae un GUID que puede cambiar cuando Samva
#   regenere el export — por eso es env var). Fuente de producción preferida.
CS360_DATA_URL=
# CS360_S3_BUCKET: bucket privado con el export real (subir con `npm run cs360:upload`;
#   credenciales AWS por la cadena del SDK, igual que avatares). Fallback de producción.
CS360_S3_BUCKET=
# Opcional: key del objeto en S3 (default cs360/contratos_exportados.json.gz)
CS360_S3_KEY=
# Opcional: ruta al export real local (JSON del stored procedure, ~44MB, NUNCA
# commitearlo). Default: mocks/healt-score/contratos_exportados.json. Fuente de dev.
CS360_DATA_FILE=
